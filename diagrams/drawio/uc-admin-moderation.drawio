<mxfile host="app.diagrams.net"><diagram name="uc-admin-moderation"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="716" pageHeight="1132" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__title__" value="Use Case Diagram — Admin (Moderation and Compliance)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110.5" y="18" width="495" height="23" as="geometry"/></mxCell><mxCell id="boundary" value="MusicLounge Platform" style="shape=folder;tabWidth=170;tabHeight=24;tabPosition=left;rounded=0;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="256" y="62" width="430" height="812" as="geometry"/></mxCell><mxCell id="h_Content review" value="Content review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="286" y="136" width="330" height="24" as="geometry"/></mxCell><mxCell id="uc_Approve or reject a venue" value="Approve or reject a venue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="168" width="330" height="58" as="geometry"/></mxCell><mxCell id="uc_Review a show" value="Review a show" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="248" width="330" height="58" as="geometry"/></mxCell><mxCell id="uc_Review a livestream" value="Review a livestream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="328" width="330" height="58" as="geometry"/></mxCell><mxCell id="uc_Force-stop a livestream" value="Force-stop a livestream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="408" width="330" height="58" as="geometry"/></mxCell><mxCell id="h_Enforcement" value="Enforcement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="286" y="518" width="330" height="24" as="geometry"/></mxCell><mxCell id="uc_Issue a venue penalty" value="Issue a venue penalty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="550" width="330" height="58" as="geometry"/></mxCell><mxCell id="uc_Review an appeal" value="Review an appeal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="630" width="330" height="58" as="geometry"/></mxCell><mxCell id="h_Complaints" value="Complaints" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="286" y="740" width="330" height="24" as="geometry"/></mxCell><mxCell id="uc_Resolve a complaint" value="Resolve a complaint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="286" y="772" width="330" height="58" as="geometry"/></mxCell><mxCell id="a_main" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;html=1;verticalAlign=top;outlineConnect=0;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="46" y="420.0" width="46" height="96" as="geometry"/></mxCell><mxCell id="note0" value="Review is advised by an AI risk score bu