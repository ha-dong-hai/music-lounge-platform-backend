<mxfile host="app.diagrams.net"><diagram name="erd-core"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="__title__" value="Core Entity Relationship Diagram (Crow&#x27;s Foot notation)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="751.5" y="18" width="477" height="23" as="geometry"/></mxCell><mxCell id="user" value="User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="230" height="64" as="geometry"/></mxCell><mxCell id="lounge" value="MusicLounge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="230" height="64" as="geometry"/></mxCell><mxCell id="staff" value="LoungeStaff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="230" height="64" as="geometry"/></mxCell><mxCell id="zone" value="SeatingZone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="230" height="64" as="geometry"/></mxCell><mxCell id="penalty" value="VenuePenalty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="230" height="64" as="geometry"/></mxCell><mxCell id="cmpl" value="Complaint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="2