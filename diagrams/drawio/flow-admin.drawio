ex="1" parent="1"><mxGeometry x="60" y="1482" width="300" height="84" as="geometry"/></mxCell><mxCell id="Ledger" value="Ledger Integrity Check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1612" width="300" height="56" as="geometry"/></mxCell><mxCell id="Analytics" value="Platform Analytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1714" width="300" height="56" as="geometry"/></mxCell><mxCell id="Jobs" value="Background Job Dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1816" width="300" height="56" as="geometry"/></mxCell><mxCell id="__init__" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="20" y="142" width="20" height="20" as="geometry"/></mxCell><mxCell id="keyhead" value="Transitions — the number on each connector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1932" width="1380" height="22" as="geometry"/></mxCell><mxCell id="key0" value="1.  Sign In  →  Venue Approval Queue  :  open the approval queue
2.  Sign In  →  Show and Livestream Moderation  :  open the moderation queue
3.  Sign In  →  Notifications Inbox  :  open notifications
4.  Venue Approval Queue  →  Venue Approval Queue  :  approve, or reject with a reason
5.  Show and Livestream Moderation  →  Show and Livestream Moderation  :  approve, or reject with a review note
6.  Livestream Room  →  Livestream Room  :  force-stop, disconnecting every viewer
7.  Issue Venue Penalty  →  Appeal Review  :  the Owner appeals
8.  Appeal Review  →  Appeal Review  :  uphold or overturn
9.  Complaint Handling  →  Refund Requests  :  resolved as refund, target is a ticket
10.  Complaint Handling  →  Donation Refunds  :  resolved as refund, target is a donation
11.  Complaint Handling  →  Complaint Handling  :  take down content, or record the outcome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="60.0" y="1958" width="680.0" height="212" as="geometry"/></mxCell><mxCell id="key1" value="12.  Refund Requests  →  Refund Requests  :  approve in full or in part, or reject
13.  Donation Refunds  →  Donation Refunds  :  reverse before the performer is paid
14.  Bank Account Verification  →  Bank Account Verification  :  verify, releasing blocked settlements
15.  User Management  →  User Management  :  search, lock or unlock an account
16.  Taxonomy Management  →  Taxonomy Management  :  create, edit or delete a tag
17.  Subscription Plan Management  →  Subscription Plan Management  :  create or edit a plan
18.  Notifications Inbox  →  Ledger Integrity Check  :  open a ledger alert
19.  Notifications Inbox  →  Platform Analytics  :  review platform activity
20.  Notifications Inbox  →  Background Job Dashboard  :  inspect a failed job
21.  Background Job Dashboard  →  Ledger Integrity Check  :  force a reconciliation run, then recheck" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="760.0" y="1958" width="680.0" height="212" as="geometry"/></mxCell><mxCell id="note" value="There is no Admin registration screen: Admin accounts are provisioned directly in the database. Bank Account Verification is reached passively — the Owner registers the account on their own screen and it arrives in this queue. Only an appeal in the Appealed state can be actioned; past the SLA the system overturns it automatically, under the same lock so the two cannot collide." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="2194" width="1380" height="70" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="152.0" as="sourcePoint"/><mxPoint x="60.0" y="152.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="148.0" as="sourcePoint"/><mxPoint x="360.0" y="263.0" as="targetPoint"/><Array as="points"><mxPoint x="420.0" y="148.0"/><mxPoint x="420.0" y="263.0"/></Array></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="163.0" as="sourcePoint"/><mxPoint x="360.0" y="365.0" as="targetPoint"/><Array as="points"><mxPoint x="460.0" y="163.0"/><mxPoint x="460.0" y="365.0"/></Array></mxGeometry></mxCell><mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="178.0" as="sourcePoint"/><mxPoint x="360.0" y="1500.0" as="targetPoint"/><Array as="points"><mxPoint x="500.0" y="178.0"/><mxPoint x="500.0" y="1500.0"/></Array></mxGeometry></mxCell><mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="278.0" as="sourcePoint"/><mxPoint x="360.0" y="293.0" as="targetPoint"/><Array as="points"><mxPoint x="540.0" y="278.0"/><mxPoint x="540.0" y="293.0"/></Array></mxGeometry></mxCell><mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="380.0" as="sourcePoint"/><mxPoint x="360.0" y="395.0" as="targetPoint"/><Array as="points"><mxPoint x="580.0" y="380.0"/><mxPoint x="580.0" y="395.0"/></Array></mxGeometry></mxCell><mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="467.0" as="sourcePoint"/><mxPoint x="360.0" y="48