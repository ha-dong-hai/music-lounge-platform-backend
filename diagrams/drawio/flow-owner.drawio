th="300" height="56" as="geometry"/></mxCell><mxCell id="Shows" value="My Shows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1657" width="300" height="56" as="geometry"/></mxCell><mxCell id="ShowEdit" value="Create or Edit Show" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1759" width="300" height="69" as="geometry"/></mxCell><mxCell id="ShowPanel" value="Show Control Panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1874" width="300" height="144" as="geometry"/></mxCell><mxCell id="Tiers" value="Ticket Tier Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2064" width="300" height="56" as="geometry"/></mxCell><mxCell id="Poster" value="Show Poster" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2166" width="300" height="56" as="geometry"/></mxCell><mxCell id="Legal" value="Legal and Royalty Declaration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2268" width="300" height="56" as="geometry"/></mxCell><mxCell id="LiveOps" value="Livestream Operation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2370" width="300" height="69" as="geometry"/></mxCell><mxCell id="DonateAck" value="Donations Awaiting Acknowledgement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2485" width="300" height="56" as="geometry"/></mxCell><mxCell id="DonatePay" value="Donations Awaiting Payout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2587" width="300" height="69" as="geometry"/></mxCell><mxCell id="Earnings" value="Earnings Overview" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2702" width="300" height="56" as="geometry"/></mxCell><mxCell id="Analytics" value="Venue Analytics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2804" width="300" height="56" as="geometry"/></mxCell><mxCell id="Penalty" value="My Penalties and Appeals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2906" width="300" height="56" as="geometry"/></mxCell><mxCell id="__init__" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="20" y="142" width="20" height="20" as="geometry"/></mxCell><mxCell id="keyhead" value="Transitions — the number on each connector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="3022" width="1680" height="22" as="geometry"/></mxCell><mxCell id="key0" value="1.  Sign Up as Owner  →  Verify Email OTP  :  submit registration
2.  Verify Email OTP  →  My Venues  :  correct code
3.  My Venues  →  Bank Accounts  :  register a payout account before trading
4.  My Venues  →  Create or Edit Venue  :  create a venue
5.  Create or Edit Venue  →  My Venues  :  submit, venue becomes Pending
6.  My Venues  →  Seating Zone Editor  :  venue approved
7.  Seating Zone Editor  →  Staff Management  :  assign staff
8.  Staff Management  →  360 Tour Manager  :  build the virtual tour
9.  360 Tour Manager  →  Venue Gallery and Criteria  :  add gallery and criteria
10.  Venue Gallery and Criteria  →  F&amp;B Menu Manager  :  set up the menu
11.  F&amp;B Menu Manager  →  F&amp;B Order Board  :  work the counter
12.  My Venues  →  Subscription Plans  :  subscribe
13.  Subscription Plans  →  My Subscription  :  choose a plan
14.  My Subscription  →  Payment Result  :  pay through the gateway
15.  Payment Result  →  My Subscription  :  subscription Active
16.  My Subscription  →  My Shows  :  subscription unlocks shows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="60.0" y="3048" width="830.0" height="302" as="geometry"/></mxCell><mxCell id="key1" value="17.  My Shows  →  Create or Edit Show  :  create a show
18.  Create or Edit Show  →  Show Control Panel  :  saved as Draft
19.  Show Control Panel  →  Ticket Tier Manager  :  define ticket tiers
20.  Show Control Panel  →  Show Poster  :  generate or upload a poster
21.  Show Control Panel  →  Legal and Royalty Declaration  :  declare permit and royalty
22.  Show Control Panel  →  Show Control Panel  :  submit for review, reschedule, cancel
23.  Show Control Panel  →  Create or Edit Show  :  rejected, returns to Draft
24.  Show Control Panel  →  Livestream Operation  :  create a livestream
25.  Livestream Operation  →  Livestream Operation  :  start and end the broadcast
26.  Livestream Operation  →  Show Control Panel  :  broadcast ended
27.  Donations Awaiting Acknowledgement  →  Donations Awaiting Payout  :  acknowledge within 24 hours
28.  Donations Awaiting Payout  →  Bank Accounts  :  performer has no bank account
29.  Donations Awaiting Payout  →  Donations Awaiting Payout  :  confirm the payout with evidence
30.  Earnings Overview  →  Venue Analytics  :  drill into one venue
31.  Earnings Overview  →  Bank Accounts  :  settlement blocked, no verified account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="910.0" y="3048" width="830.0" height="302" as="geometry"/></mxCell><mxCell id="note" value="Donations Awaiting Acknowledgement is reached passively when a donation clears, not by navigation; if the Owner does not acknowledge within 24 hours the system confirms it for them. A rejected venue cannot be resubmitted — the Owner creates a new one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="3374" width="1680" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="152.0" as="sourcePoint"/><mxPoint x="60.0" y="152.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="148.0" as="sourcePoint"/><mxPoint x="360.0" y="250.0" as="targetPoint"/><Array as="points"><mxPoint x="420.0" y="148.0"/><mxPoint x="420.0" y="250.0"/></Array></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="265.0" as="sourcePoint"/><mxPoint x="360.0" 