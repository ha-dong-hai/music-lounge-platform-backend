ometry"/></mxCell><mxCell id="__init__" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;ellipse;" vertex="1" parent="1"><mxGeometry x="20" y="142" width="20" height="20" as="geometry"/></mxCell><mxCell id="keyhead" value="Transitions — the number on each connector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="2668" width="1560" height="22" as="geometry"/></mxCell><mxCell id="key0" value="1.  Sign Up  →  Verify Email OTP  :  submit registration
2.  Verify Email OTP  →  Show List and Search  :  correct code
3.  Verify Email OTP  →  Verify Email OTP  :  wrong or expired code, resend
4.  Sign In  →  Show List and Search  :  sign in
5.  Sign In  →  Reset Password  :  forgot password
6.  Reset Password  →  Sign In  :  password set
7.  Show List and Search  →  Show Detail  :  pick a show
8.  Show List and Search  →  Recommendations  :  open recommendations
9.  Recommendations  →  Show Detail  :  pick a suggestion
10.  Show Detail  →  Venue Detail  :  view the venue
11.  Venue Detail  →  360 Virtual Tour  :  explore the tour
12.  Show Detail  →  Select Tickets and Hold  :  buy tickets
13.  Select Tickets and Hold  →  Select Tickets and Hold  :  cancel, seats released
14.  Select Tickets and Hold  →  Payment Result  :  pay through the gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="60.0" y="2694" width="770.0" height="266" as="geometry"/></mxCell><mxCell id="key1" value="15.  Payment Result  →  Ticket Detail and QR  :  payment succeeded
16.  Payment Result  →  Select Tickets and Hold  :  payment failed, hold again
17.  My Tickets  →  Ticket Detail and QR  :  open a ticket
18.  Ticket Detail and QR  →  My Tickets  :  transfer or cancel
19.  Show Detail  →  Livestream Room  :  show Ongoing, ticket held
20.  Livestream Room  →  Donate Form  :  tip a performer
21.  Donate Form  →  Payment Result  :  pay through the gateway
22.  Payment Result  →  Livestream Room  :  back to the stream
23.  Payment Result  →  My Donations  :  view donation history
24.  Venue Detail  →  F&amp;B Menu  :  browse the menu
25.  Show Detail  →  F&amp;B Menu  :  browse the menu
26.  F&amp;B Menu  →  My F&amp;B Orders  :  place an order
27.  Show Detail  →  Rate Show  :  show has Ended
28.  Show Detail  →  File Complaint  :  report a problem" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=12;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="850.0" y="2694" width="770.0" height="266" as="geometry"/></mxCell><mxCell id="note" value="Notifications and Profile are reachable from the account menu at any point, so they carry no incoming transition rather than repeating an edge from every screen. My F&amp;B Orders changes as Staff advance the order; there is no push, so the screen must be reopened to see it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;shape=note;size=14;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="2984" width="1560" height="70" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="152.0" as="sourcePoint"/><mxPoint x="60.0" y="152.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="148.0" as="sourcePoint"/><mxPoint x="360.0" y="250.0" as="targetPoint"/><Array as="points"><mxPoint x="420.0" y="148.0"/><mxPoint x="420.0" y="250.0"/></Array></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;fontColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="265.0" as="sourcePoint"/><mxPoint x="360.0" y="5