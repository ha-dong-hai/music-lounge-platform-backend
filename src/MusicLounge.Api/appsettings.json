{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [ "https://your-production-domain.example" ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "MusicLounge",
    "Audience": "MusicLounge.Client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "Version": "2.1.0"
  },
  "Business": {
    "PlatformCommissionRate": 0.05,
    "TaxRate": 0.05,
    "TicketHoldMinutes": 15,
    "TicketPaymentReturnUrl": "https://musiclounge.vn/api/v1/payments/vnpay/callback",
    "DonationPaymentReturnUrl": "https://musiclounge.vn/api/v1/donations/vnpay-return",
    "SubscriptionPaymentReturnUrl": "https://musiclounge.vn/api/v1/subscriptions/vnpay-return"
  },
  "Firebase": {
    "ProjectId": ""
  },
  "Cloudflare": {
    "ApiToken": "",
    "AccountId": ""
  },
  "Mux": {
    "TokenId": "",
    "TokenSecret": ""
  },
  "Gemini": {
    "ApiKey": ""
  },
  "OpenAi": {
    "ApiKey": ""
  },
  "SecurityDetection": {
    "LoginSpikeWindowMinutes": 10,
    "LoginSpikeMinDistinctAccounts": 5,
    "LoginSpikeMinTotalAttempts": 10,
    "LoginSpikeAlertCooldownHours": 1,
    "LoginFailureLogRetentionHours": 24
  },
  "PanoramaStitcher": {
    "BaseUrl": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromAddress": "no-reply@musiclounge.vn",
    "FromName": "MusicLounge"
  },
  "Livestream": {
    "Provider": "cloudflare"
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/musiclounge-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
